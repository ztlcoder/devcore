
{
    "version": "8.4.27-1",
    "description": "A popular general-purpose scripting language that is especially suited for web development. (non-thread safe)",
    "homepage": "https://www.php.net/",
    "license": "PHP-3.01",
    "suggest": {
        "vcredist": "extras/vcredist2022"
    },
    "architecture": {
        "64bit": {
            "url": "https://downloads.php.net/~windows/releases/archives/php-8.4.27-1-nts-Win32-vs17-x64.zip",
            "hash": "dbae154a0a89791f36c3d48e68bae797878333e7d6cb5721e74617de59b63ab7"
        },
        "32bit": {
            "url": "https://downloads.php.net/~windows/releases/archives/php-8.4.27-1-nts-Win32-vs17-x86.zip",
            "hash": "136209338d26807614afdaf4708cdd6fd9b7699446971bc31ef9d6dfab552c59"
        }
    },
    "pre_install": [
        "if (-not (Test-Path -LiteralPath (Join-Path $persist_dir 'php.ini'))) {",
        "    Copy-Item -LiteralPath (Join-Path $dir 'php.ini-development') -Destination (Join-Path $dir 'php.ini')",
        "}"
    ],
    "post_install": [
        "$ini = Join-Path $dir 'php.ini'",
        "$content = [System.IO.File]::ReadAllText($ini)",
        "$content = $content -replace '(?m)^;\\s*(extension_dir\\s*=\\s*\"ext\")', '$1'",
        "[System.IO.File]::WriteAllText($ini, $content)"
    ],
    "bin": [
        "php.exe",
        "php-cgi.exe",
        "phpdbg.exe"
    ],
    "persist": [
        "ext",
        "php.ini"
    ],
    "checkver": {
        "url": "https://downloads.php.net/~windows/releases/releases.json",
        "jsonpath": "$['8.4'].version"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://downloads.php.net/~windows/releases/archives/php-$version-nts-Win32-vs17-x64.zip"
            },
            "32bit": {
                "url": "https://downloads.php.net/~windows/releases/archives/php-$version-nts-Win32-vs17-x86.zip"
            }
        }
    }
}
