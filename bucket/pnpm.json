{
    "version": "12.21.0",
    "description": "A fast and disk space efficient Node package manager.",
    "homepage": "https://pnpm.io/",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/pnpm/pnpm/releases/download/v12.21.0/pnpm-win32-x64.zip",
            "hash": "4fb64bb37e46c788309e0fd4ea93beb512546fdc7348121194fb704fbb72c09c"
        },
        "arm64": {
            "url": "https://github.com/pnpm/pnpm/releases/download/v12.21.0/pnpm-win32-arm64.zip",
            "hash": "9584890db13a8bcd9a77556f3455e37718a17a31c0aee0254cf8d8ac6b3a8df1"
        }
    },
    "bin": [
        "pnpm.exe",
        [
            "pnpm.exe",
            "pn"
        ],
        [
            "pnpm.exe",
            "pnpx",
            "dlx"
        ],
        [
            "pnpm.exe",
            "pnx",
            "dlx"
        ]
    ],
    "post_install": [
        "# Configure pnpm directories under Scoop persistent directory",
        "& \"$dir\\pnpm.exe\" config set storeDir \"$persist_dir\\store\"",
        "& \"$dir\\pnpm.exe\" config set cacheDir \"$persist_dir\\cache\"",
        "& \"$dir\\pnpm.exe\" config set stateDir \"$persist_dir\\state\""
    ],
    "env_add_path": "bin",
    "env_set": {
        "PNPM_HOME": "$dir"
    },
    "persist": [
        "bin",
        "global",
        "store",
        "cache",
        "state"
    ],
    "checkver": {
        "github": "https://api.github.com/repos/pnpm/pnpm/releases",
        "script": [
            "# Check all release tags and select the latest stable version",
            "$releases = $page | ConvertFrom-Json -ErrorAction Ignore",
            "$latest_ver = [Version]::new(0,0,0,0)",
            "$releases | ForEach-Object {",
            "    if (!($_.tag_name -match '([\\d.]+)')) { return }",
            "    if ($_.prerelease) { return }",
            "    $ver = [Version]::new($matches[1])",
            "    if ($ver -gt $latest_ver) { $latest_ver = $ver }",
            "}",
            "if ($latest_ver -eq [Version]::new(0,0,0,0)) { error \"Could not match version string in '$url'\"; return }",
            "Write-Output $latest_ver"
        ],
        "regex": "([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/pnpm/pnpm/releases/download/v$version/pnpm-win32-x64.zip"
            },
            "arm64": {
                "url": "https://github.com/pnpm/pnpm/releases/download/v$version/pnpm-win32-arm64.zip"
            }
        }
    }
}
