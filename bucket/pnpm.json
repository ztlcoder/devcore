{
    "version": "12.17.0",
    "description": "A fast and disk space efficient Node package manager.",
    "homepage": "https://pnpm.io/",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/pnpm/pnpm/releases/download/v12.17.0/pnpm-win32-x64.zip",
            "hash": "f160b053dac663c5931975d244920836ec26e6bc3516a42518db44c9d5c2ffc2"
        },
        "arm64": {
            "url": "https://github.com/pnpm/pnpm/releases/download/v12.17.0/pnpm-win32-arm64.zip",
            "hash": "a762db3ca8975ab50356b2164b8bb988e0a10b5519476a387cd4df0678531f78"
        }
    },
    "bin": [
        "pnpm.exe",
        [
            "pnpm.exe",
            "pn"
        ],
        [
            "pnpm.exe",
            "pnpx",
            "dlx"
        ],
        [
            "pnpm.exe",
            "pnx",
            "dlx"
        ]
    ],
    "post_install": [
        "# Configure all pnpm data directories under the persistent directory",
        "$pnpm = Join-Path $dir 'pnpm.exe'",
        "$pnpm config set store-dir (Join-Path $persist_dir 'store')",
        "$pnpm config set cache-dir (Join-Path $persist_dir 'cache')",
        "$pnpm config set state-dir (Join-Path $persist_dir 'state')",
        "$pnpm config set global-dir (Join-Path $persist_dir 'global')",
        "$pnpm config set global-bin-dir (Join-Path $persist_dir 'bin')"
    ],
    "post_uninstall": [
        "if ($cmd -eq 'uninstall') {",
        "    foreach ($name in @('bin', 'global', 'store', 'cache', 'state')) {",
        "        $path = Join-Path $persist_dir $name",
        "        if (Test-Path -LiteralPath $path) {",
        "            Remove-Item -LiteralPath $path -Recurse -Force",
        "        }",
        "    }",
        "}"
    ],
    "env_add_path": "bin",
    "env_set": {
        "PNPM_HOME": "$dir"
    },
    "persist": [
        "bin",
        "global",
        "store",
        "cache",
        "state"
    ],
    "checkver": {
        "github": "https://api.github.com/repos/pnpm/pnpm/releases",
        "script": [
            "# Check all release tags and select the latest stable version",
            "$releases = $page | ConvertFrom-Json -ErrorAction Ignore",
            "$latest_ver = [Version]::new(0,0,0,0)",
            "$releases | ForEach-Object {",
            "    if (!($_.tag_name -match '([\\d.]+)')) { return }",
            "    if ($_.prerelease) { return }",
            "    $ver = [Version]::new($matches[1])",
            "    if ($ver -gt $latest_ver) { $latest_ver = $ver }",
            "}",
            "if ($latest_ver -eq [Version]::new(0,0,0,0)) { error \"Could not match version string in '$url'\"; return }",
            "Write-Output $latest_ver"
        ],
        "regex": "([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/pnpm/pnpm/releases/download/v$version/pnpm-win32-x64.zip"
            },
            "arm64": {
                "url": "https://github.com/pnpm/pnpm/releases/download/v$version/pnpm-win32-arm64.zip"
            }
        }
    }
}
