{
    "version": "12.14.0",
    "description": "A fast and disk space efficient Node package manager.",
    "homepage": "https://pnpm.io/",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/pnpm/pnpm/releases/download/v12.14.0/pnpm-win32-x64.zip",
            "hash": "6f0f38e917c8ce76ef31db528c357e2bfa354a1bcb16464e3cdec39e6530d784"
        },
        "arm64": {
            "url": "https://github.com/pnpm/pnpm/releases/download/v12.14.0/pnpm-win32-arm64.zip",
            "hash": "97f707ce677b7591bad9d95c1f74635b5b2b9468da92ef94d426db4453524357"
        }
    },
    "env_set": {
        "PNPM_HOME": "$persist_dir\\global",
        "XDG_CONFIG_HOME": "$persist_dir\\config",
        "XDG_CACHE_HOME": "$persist_dir\\cache",
        "XDG_DATA_HOME": "$persist_dir\\data",
        "XDG_STATE_HOME": "$persist_dir\\state",
        "pnpm_config_registry": "https://registry.npmmirror.com/"
    },
    "env_add_path": "global",
    "bin": [
        "pnpm.exe",
        [
            "pnpm.exe",
            "pnpx"
        ]
    ],
    "persist": [
        "config",
        "store",
        "cache",
        "state",
        "global"
    ],
    "post_install": [
        "& \"$dir\\pnpm.exe\" config set store-dir \"$persist_dir\\store\"",
        "& \"$dir\\pnpm.exe\" config set cache-dir \"$persist_dir\\cache\"",
        "& \"$dir\\pnpm.exe\" config set state-dir \"$persist_dir\\state\"",
        "& \"$dir\\pnpm.exe\" config set global-bin-dir \"$persist_dir\\global\""
    ],
    "uninstaller": {
        "script": [
            "# 1. 强行删除 persist 持久化数据目录（包含 store, config, global 等）",
            "if (Test-Path $persist_dir) {",
            "    Remove-Item -Path $persist_dir -Recurse -Force -ErrorAction SilentlyContinue",
            "}",
            "# 2. 强行清理可能残留在用户注册表中的 pnpm 环境变量（双重保险）",
            "$envVars = @('PNPM_HOME', 'XDG_CONFIG_HOME', 'XDG_CACHE_HOME', 'XDG_DATA_HOME', 'XDG_STATE_HOME', 'pnpm_config_registry')",
            "foreach ($var in $envVars) {",
            "    [Environment]::SetEnvironmentVariable($var, $null, 'User')",
            "}"
        ]
    },
    "checkver": {
        "github": "https://github.com/pnpm/pnpm"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/pnpm/pnpm/releases/download/v$version/pnpm-win32-x64.zip"
            },
            "arm64": {
                "url": "https://github.com/pnpm/pnpm/releases/download/v$version/pnpm-win32-arm64.zip"
            }
        }
    }
}
