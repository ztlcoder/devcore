
{
    "version": "8.3.36-1",
    "description": "A popular general-purpose scripting language that is especially suited for web development. (non-thread safe)",
    "homepage": "https://www.php.net/",
    "license": "PHP-3.01",
    "suggest": {
        "vcredist": "extras/vcredist2022"
    },
    "architecture": {
        "64bit": {
            "url": "https://downloads.php.net/~windows/releases/archives/php-8.3.36-1-nts-Win32-vs16-x64.zip",
            "hash": "1a097d52b7a68622cdc723073b61cc70caf79c941218ff65b2d8441dbc6b10d4"
        },
        "32bit": {
            "url": "https://downloads.php.net/~windows/releases/archives/php-8.3.36-1-nts-Win32-vs16-x86.zip",
            "hash": "2dd0c25c136812d2b7fdca85cbdd442a28aee758bff938c973f644c1c9235b98"
        }
    },
    "pre_install": [
        "if (-not (Test-Path -LiteralPath (Join-Path $persist_dir 'php.ini'))) {",
        "    Copy-Item -LiteralPath (Join-Path $dir 'php.ini-development') -Destination (Join-Path $dir 'php.ini')",
        "}"
    ],
    "post_install": [
        "$ini = Join-Path $dir 'php.ini'",
        "$content = [System.IO.File]::ReadAllText($ini)",
        "$content = $content -replace '(?m)^;\\s*(extension_dir\\s*=\\s*\"ext\")', '$1'",
        "[System.IO.File]::WriteAllText($ini, $content)"
    ],
    "bin": [
        "php.exe",
        "php-cgi.exe",
        "phpdbg.exe"
    ],
    "persist": [
        "ext",
        "php.ini"
    ],
    "checkver": {
        "url": "https://downloads.php.net/~windows/releases/releases.json",
        "jsonpath": "$['8.3'].version"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://downloads.php.net/~windows/releases/archives/php-$version-nts-Win32-vs16-x64.zip"
            },
            "32bit": {
                "url": "https://downloads.php.net/~windows/releases/archives/php-$version-nts-Win32-vs16-x86.zip"
            }
        }
    }
}
