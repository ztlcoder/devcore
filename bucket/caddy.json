        }
    },
    "bin": "caddy.exe",
    "pre_install": [
        "if (-not (Test-Path -LiteralPath (Join-Path $persist_dir 'caddy'))) {",
        "    $caddyDir = Join-Path $dir 'caddy'",
        "    New-Item -ItemType Directory -Path (Join-Path $caddyDir 'logs') -Force | Out-Null",
        "    New-Item -ItemType File -Path (Join-Path $caddyDir 'Caddyfile') -Force | Out-Null",
        "}"
    ],
    "persist": [
        "caddy"
    ],
    "post_uninstall": [
        "if ($cmd -eq 'uninstall' -and $env:APPDATA) {",
        "    $caddyAppData = Join-Path $env:APPDATA 'Caddy'",
        "    if (Test-Path -LiteralPath $caddyAppData) {",
        "        Remove-Item -LiteralPath $caddyAppData -Recurse -Force",
        "    }",
        "}"
    ],
    "checkver": {
        "github": "https://github.com/caddyserver/caddy"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/caddyserver/caddy/releases/download/v$version/caddy_$version_windows_amd64.zip"
            },
            "arm64": {
                "url": "https://github.com/caddyserver/caddy/releases/download/v$version/caddy_$version_windows_arm64.zip"
            }
        },
        "hash": {
            "url": "$baseurl/caddy_$version_checksums.txt"
        }
    }
}