{
    "version": "2.10.0",
    "description": "Dependency Manager for PHP",
    "homepage": "https://getcomposer.org/",
    "license": "MIT",
    "notes": "'composer selfupdate' is aliased to 'scoop update composer'",
    "suggest": {
        "PHP": [
            "php",
            "php-nts"
        ]
    },
    "url": "https://getcomposer.org/download/2.10.0/composer.phar",
    "hash": "a346538851988ead111d11e3cbd7d372eeba44abd0af412e09890d3c21ea6c31",
    "pre_install": [
        "@(",
        "    'if ($args.length -eq 1 -and ($args -eq \"selfupdate\" -or $args -eq \"self-update\")) { & scoop update composer }'",
        "    'else { & php (Join-Path $PSScriptRoot \"composer.phar\") @args }'",
        ") | Add-Content -Path \"$dir\\composer.ps1\"",
        "if (!(Test-Path \"$persist_dir\\vendor\") -and (Test-Path \"$env:Appdata\\Composer\")) {",
        "    Write-Host -F yellow \"Moving old 'COMPOSER_HOME' to '$persist_dir'\"",
        "    Move-Item \"$env:Appdata\\Composer\\*\" \"$persist_dir\" -Force -ErrorAction SilentlyContinue",
        "}"
    ],
    "bin": "composer.ps1",
    "env_set": {
        "COMPOSER_HOME": "$persist_dir",
        "COMPOSER_CACHE_DIR": "$persist_dir\\cache"
    },
    "env_add_path": "vendor\\bin",
    "persist": [
        "vendor",
        "cache",
        "auth.json"
    ],
    "checkver": "Latest: <strong>\\s*([\\d.]+)\\s*</strong>",
    "autoupdate": {
        "url": "https://getcomposer.org/download/$version/composer.phar",
        "hash": {
            "url": "$url.sha256sum"
        }
    }
}
