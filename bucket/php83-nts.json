  "license": "PHP-3.01",
  "suggest": {
    "vcredist": "extras/vcredist2022"
  },
  "architecture": {
    "64bit": {
      "url": "https://downloads.php.net/~windows/releases/archives/php-8.3.32-nts-Win32-vs16-x64.zip",
      "hash": "67c724e7b675b50d8f0476d816c3e2a3064ce3a53d572575d63c321cc0a3a6cf"
    },
    "32bit": {
      "url": "https://downloads.php.net/~windows/releases/archives/php-8.3.32-nts-Win32-vs16-x86.zip",
      "hash": "f4053d542dda43b4e684be03d87f1b61bf8ccfe5a5ae9ad72ea59b4015234ea8"
    }
  },
  "pre_install": [
    "if (!(Test-Path \"$dir\\php.ini\")) { Copy-Item \"$dir\\php.ini-development\" \"$dir\\php.ini\" }"
  ],
  "post_install": [
    "(Get-Content \"$dir\\php.ini\") | % { $_ -replace ';\\s?(extension_dir = \"ext\")', '$1' } | Set-Content \"$dir\\php.ini\""
  ],
  "bin": [
    "php.exe",
    "php-cgi.exe",
    "phpdbg.exe"
  ],
  "persist": [
    "ext",
    "php.ini"
  ],
  "checkver": {
    "url": "https://downloads.php.net/~windows/releases/releases.json",
    "jsonpath": "$.[?(@.version =~ /^8\\.5\\.\\d+/)]",
    "reverse": true
  },
  "autoupdate": {
    "architecture": {
      "64bit": {
        "url": "https://downloads.php.net/~windows/releases/archives/php-$version-nts-Win32-vs16-x64.zip"
      },
      "32bit": {
        "url": "https://downloads.php.net/~windows/releases/archives/php-$version-nts-Win32-vs16-x86.zip"
      }
    },
    "hash": {
      "url": "https://downloads.php.net/~windows/releases/releases.json",
      "jsonpath": "$.$version.nts.$architecture.sha256"
    }
  }
}
