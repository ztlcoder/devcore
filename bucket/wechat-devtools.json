{
  "homepage": "https://developers.weixin.qq.com/miniprogram/dev/devtools/devtools.html",
  "description": "微信开发者工具官方版",
  "version": "2.02.2608070",
  "license": "Freeware",
  "url": "https://devtools.wxqcloud.qq.com.cn/WechatWebDev/release/be1ec64cf6184b0fa64091919793f068/wechat_devtools_2.02.2608070_win32_x64.exe#/installer.exe",
  "hash": "a502dead2e4fb6dcb0b5e157e1f2b9ac00c10a20f1940917112a1f8481ed5ed9",
  "persist": "wechat-devtools",
  "installer": {
    "script": [
      "Expand-7zipArchive \"$dir\\installer.exe\" \"$dir\\app\" -Removal",
      "@('$PLUGINSDIR', '卸载微信开发者工具.exe.nsis') | ForEach-Object {",
      "    if (Test-Path \"$dir\\app\\$_\") { Remove-Item \"$dir\\app\\$_\" -Recurse -Force -ErrorAction SilentlyContinue }",
      "}",
      "if (!(Test-Path \"$persist_dir\")) { New-Item \"$persist_dir\" -ItemType Directory | Out-Null }",
      "$appdata_path = \"$env:APPDATA\\微信开发者工具\"",
      "if (Test-Path $appdata_path) { if (!((Get-Item $appdata_path).Attributes -match 'ReparsePoint')) { Copy-Item \"$appdata_path\\*\" \"$persist_dir\" -Recurse -Force; Remove-Item $appdata_path -Recurse -Force } }",
      "New-Item -ItemType Junction -Path $appdata_path -Target \"$persist_dir\" -Force | Out-Null"
    ]
  },
  "uninstaller": {
    "script": "Remove-Item \"$env:APPDATA\\微信开发者工具\" -Force -Recurse"
  },
  "shortcuts": [
    [
      "app\\微信开发者工具.exe",
      "微信开发者工具"
    ]
  ],
  "checkver": {
    "url": "https://developers.weixin.qq.com/miniprogram/dev/devtools/stable.html",
    "regex": "/release/(?<path>[a-f0-9]+)/wechat_devtools_(?<version>[\\d.]+)_win32_x64\\.exe"
  },
  "autoupdate": {
    "url": "https://devtools.wxqcloud.qq.com.cn/WechatWebDev/release/$matchPath/wechat_devtools_$version_win32_x64.exe#/installer.exe"
  },
  "notes": "User data is persisted in the 'wechat-devtools' folder and symlinked to %APPDATA%."
}
