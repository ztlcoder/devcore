{
    "version": "5.4.7",
    "description": "Powerful software uninstaller with advanced leftover scanning.",
    "homepage": "https://www.revouninstaller.com/",
    "license": "Shareware",
    "url": "https://download.revouninstaller.com/download/RevoUninProSetup.exe",
    "hash": "6552AE17F3A024D74DB56B083B91895D780EDE60423EACDB578A03103EDFFC21",
    "innosetup": true,
    "pre_install": [
        "# 1. 修复所有带逗号后缀的文件名",
        "Get-ChildItem \"$dir\" -Recurse | Where-Object { $_.Name -match ',\\d+\\.' } | ForEach-Object {",
        "    $newName = $_.Name -replace ',\\d+', ''",
        "    $target = Join-Path $_.DirectoryName $newName",
        "    if (!(Test-Path $target)) { Move-Item $_.FullName $target -Force }",
        "}",
        "# 2. 移动核心程序文件",
        "if (Test-Path \"$dir\\{app}\") {",
        "    Move-Item \"$dir\\{app}\\*\" \"$dir\" -Force",
        "    Remove-Item \"$dir\\{app}\" -Force -Recurse",
        "}",
        "# 3. 提取授权文件并存入标准位置",
        "if (Test-Path \"$dir\\{commonappdata}\") {",
        "    $revoData = New-Item \"$dir\\VS Revo Group\\Revo Uninstaller Pro\" -ItemType Directory -Force",
        "    $licFile = Get-ChildItem \"$dir\\{commonappdata}\" -Recurse -Filter \"*.lic\" | Select-Object -First 1",
        "    if ($licFile) { Move-Item $licFile.FullName $revoData.FullName -Force }",
        "    Remove-Item \"$dir\\{commonappdata}\" -Force -Recurse",
        "}",
        "Get-ChildItem \"$dir\" -Include '{*}' -Directory | Remove-Item -Force -Recurse"
    ],
    "installer": {
        "script": [
            "# 1. 初始化持久化数据总目录",
            "if (!(Test-Path \"$persist_dir\")) { New-Item \"$persist_dir\" -ItemType Directory -Force | Out-Null }",
            "# 2. 将解压出的授权释放到持久化目录",
            "$targetPersistDir = \"$persist_dir\\VS Revo Group\"",
            "if (!(Test-Path $targetPersistDir) -and (Test-Path \"$dir\\VS Revo Group\")) {",
            "    Move-Item \"$dir\\VS Revo Group\" \"$persist_dir\" -Force",
            "}",
            "# 3. 建立 Junction 链接到 %ProgramData%",
            "$commonData = \"$env:ProgramData\\VS Revo Group\"",
            "if (Test-Path $commonData) {",
            "    $item = Get-Item $commonData",
            "    if ($item.LinkType -ne 'Junction') { Remove-Item $commonData -Force -Recurse } else { $item.Delete() }",
            "}",
            "if (!(Test-Path $commonData)) {",
            "    New-Item -Path $commonData -ItemType Junction -Target $targetPersistDir -Force | Out-Null",
            "}"
        ]
    },
    "uninstaller": {
        "script": [
            "# 卸载时仅解除 Junction 软链接",
            "$commonData = \"$env:ProgramData\\VS Revo Group\"",
            "if (Test-Path $commonData) {",
            "    $item = Get-Item $commonData",
            "    if ($item.LinkType -eq 'Junction') { $item.Delete() }",
            "}",
            "$appData = \"$env:AppData\\VS Revo Group\"",
            "if (Test-Path $appData) { Remove-Item $appData -Force -Recurse -ErrorAction SilentlyContinue }"
        ]
    ],
    "bin": "RevoUninPro.exe",
    "shortcuts": [
        [
            "RevoUninPro.exe",
            "Revo Uninstaller Pro"
        ]
    ],
    "elevate": true,
    "checkver": {
        "url": "https://revouninstaller.com",
        "re": "Version ([\\d.]+)"
    },
    "autoupdate": {
        "url": "https://download.revouninstaller.com/download/RevoUninProSetup.exe"
    }
}