{
    "version": "3.0.2",
    "description": "ZTools software application.",
    "homepage": "https://github.com/ZToolsCenter/ZTools",
    "license": "Unknown",
    "architecture": {
        "64bit": {
            "url": "https://github.com/ZToolsCenter/ZTools/releases/download/v3.0.2/ZTools-3.0.2-win-x64.zip",
            "hash": "75ef86d63eb65ff599c20e166f94951523d08082c01398d43a94e0eff065cd82"
        }
    },
    "bin": "ZTools.exe",
    "shortcuts": [
        [
            "ZTools.exe",
            "ZTools"
        ]
    ],
    "uninstaller": {
        "script": [
            "$appDataDirs = @(",
            "    \"$env:USERPROFILE\\.ztools\",",
            "    \"$env:APPDATA\\ZTools\"",
            ")",
            "foreach ($dir in $appDataDirs) {",
            "    if (Test-Path $dir) {",
            "        Remove-Item $dir -Recurse -Force -ErrorAction SilentlyContinue",
            "    }",
            "}",
            "$fuzzyPaths = @(",
            "    \"$env:LOCALAPPDATA\\CrashDumps\\*ZTools*\",",
            "    \"$env:ProgramData\\Microsoft\\Windows\\WER\\ReportArchive\\*ZTools*\",",
            "    \"${env:ProgramFiles(x86)}\\sougou\\用户数据\\SogouPY\\LOG\\IME\\*ZTools*\",",
            "    \"$env:ProgramFiles\\sougou\\用户数据\\SogouPY\\LOG\\IME\\*ZTools*\"",
            ")",
            "foreach ($path in $fuzzyPaths) {",
            "    Get-Item -Path $path -ErrorAction SilentlyContinue | Remove-Item -Recurse -Force -ErrorAction SilentlyContinue",
            "}"
        ]
    },
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/ZToolsCenter/ZTools/releases/download/v$version/ZTools-$version-win-x64.zip"
            }
        }
    }
}
