{
    "version": "18.7-1",
    "description": "Object-relational database management system based on POSTGRES.",
    "homepage": "https://www.postgresql.org",
    "license": "PostgreSQL",
    "notes": [
        "Run 'pg_ctl start' to start the database and 'pg_ctl stop' to stop it.",
        "Register it as a service by running 'pg_ctl register -N PostgreSQL -D \"$persist_dir\\data\"' from an elevated shell.",
        "Add service description by running 'sc.exe description PostgreSQL \"PostgreSQL Database Server\"' from an elevated shell.",
        "Default superuser login: postgres, password: <blank>",
        "WARNING: Uninstalling this package deletes the PostgreSQL database and all persisted data."
    ],
    "architecture": {
        "64bit": {
            "url": "https://get.enterprisedb.com/postgresql/postgresql-18.7-1-windows-x64-binaries.zip",
            "hash": "ead0bbc27fb678fa24dcf86b738981323042abd073c744103bf7f3aed23f9a33"
        }
    },
    "extract_dir": "pgsql",
    "pre_install": [
        "if (-not (Test-Path -LiteralPath (Join-Path $persist_dir 'data'))) {",
        "    New-Item -ItemType Directory -Path (Join-Path $dir 'data') -Force | Out-Null",
        "}"
    ],
    "post_install": [
        "$dataDir = Join-Path $dir 'data'",
        "if (-not (Test-Path -LiteralPath (Join-Path $dataDir 'PG_VERSION'))) {",
        "    Invoke-ExternalCommand -FilePath (Join-Path $dir 'bin\\initdb.exe') -ArgumentList @('--username=postgres', '--encoding=UTF8', '--locale=C', \"--pgdata=$dataDir\") | Out-Null",
        "}"
    ],
    "pre_uninstall": [
        "$service = Get-Service -Name 'PostgreSQL' -ErrorAction SilentlyContinue",
        "if ($service) {",
        "    if ($service.Status -ne 'Stopped') {",
        "        Stop-Service -Name 'PostgreSQL' -Force -ErrorAction Stop",
        "    }",
        "    & (Join-Path $dir 'bin\\pg_ctl.exe') unregister -N PostgreSQL",
        "    if ($LASTEXITCODE -ne 0) {",
        "        throw 'Failed to unregister PostgreSQL service. Uninstallation stopped.'",
        "    }",
        "}"
    ],
    "post_uninstall": [
        "if ($cmd -eq 'uninstall') {",
        "    $dataDir = Join-Path $persist_dir 'data'",
        "    if (Test-Path -LiteralPath $dataDir) {",
        "        Remove-Item -LiteralPath $dataDir -Recurse -Force",
        "    }",
        "    if ($env:APPDATA) {",
        "        $appDataDir = Join-Path $env:APPDATA 'PostgreSQL'",
        "        if (Test-Path -LiteralPath $appDataDir) {",
        "            Remove-Item -LiteralPath $appDataDir -Recurse -Force",
        "        }",
        "    }",
        "}"
    ],
    "shortcuts": [
        [
            "pgAdmin 4\\runtime\\pgAdmin4.exe",
            "pgAdmin 4"
        ]
    ],
    "env_add_path": "bin",
    "env_set": {
        "PGDATA": "$dir\\data",
        "PG_LIB_DIR": "$dir\\lib",
        "PG_INCLUDE_DIR": "$dir\\include"
    },
    "persist": "data",
    "checkver": {
        "url": "https://www.enterprisedb.com/downloads/postgres-postgresql-downloads",
        "script": [
            "$url = ([xml]$page).SelectSingleNode('//table/tbody/tr[1]/td[5]/a').href",
            "$request = [System.Net.HttpWebRequest]::Create($url)",
            "$request.UserAgent = (Get-UserAgent)",
            "$response = $request.GetResponse()",
            "Write-Output $response.ResponseUri.AbsoluteUri"
        ],
        "regex": "postgresql-(?<version>\\d+\\.\\d+-\\d+)-windows"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://get.enterprisedb.com/postgresql/postgresql-$version-windows-x64-binaries.zip"
            }
        }
    }
}
