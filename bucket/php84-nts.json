{
  "version": "8.4.26",
  "description": "A popular general-purpose scripting language that is especially suited to web development. (non-thread safe)",
  "homepage": "https://www.php.net/",
  "license": "PHP-3.01",
  "suggest": {
    "vcredist": "extras/vcredist2022"
  },
  "architecture": {
    "64bit": {
      "url": "https://downloads.php.net/~windows/releases/archives/php-8.4.26-nts-Win32-vs17-x64.zip",
      "hash": "da68394f9193b7f6b89d0c76861a4034ae10efee7fd55a7255d8118c2acf70d7"
    },
    "32bit": {
      "url": "https://downloads.php.net/~windows/releases/archives/php-8.4.26-nts-Win32-vs17-x86.zip",
      "hash": "82dbaa361e035237a6ed0ade126f837798c7bf0565610b73ddb40986fc107128"
    }
  },
  "pre_install": [
    "if (!(Test-Path \"$dir\\php.ini\")) { Copy-Item \"$dir\\php.ini-development\" \"$dir\\php.ini\" }"
  ],
  "post_install": [
    "(Get-Content \"$dir\\php.ini\") | % { $_ -replace ';\\s?(extension_dir = \"ext\")', '$1' } | Set-Content \"$dir\\php.ini\""
  ],
  "bin": [
    "php.exe",
    "php-cgi.exe",
    "phpdbg.exe"
  ],
  "persist": [
    "ext",
    "php.ini"
  ],
  "checkver": {
    "url": "https://downloads.php.net/~windows/releases/releases.json",
    "jsonpath": "$.[?(@.version =~ /^8\\.5\\.\\d+/)]",
    "reverse": true
  },
  "autoupdate": {
    "architecture": {
      "64bit": {
        "url": "https://downloads.php.net/~windows/releases/archives/php-$version-nts-Win32-vs17-x64.zip"
      },
      "32bit": {
        "url": "https://downloads.php.net/~windows/releases/archives/php-$version-nts-Win32-vs17-x86.zip"
      }
    },
    "hash": {
      "url": "https://downloads.php.net/~windows/releases/releases.json",
      "jsonpath": "$.$version.nts.$architecture.sha256"
    }
  }
}
